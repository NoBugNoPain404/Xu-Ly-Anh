# --- CẤU HÌNH HỆ THỐNG ROBOFLOW ---
ROBOFLOW_API_BASE=https://serverless.roboflow.com
API_KEY=
WORKSPACE=huyquang075s-workspace

# --- STAGE 1: DETECT KHUNG THẺ (card_detector.py) ---
# Ghép từ tên project cũ "detect-count-and-visualize-3" và version "1" của bạn
MODEL_ID=detect-count-and-visualize-3/1

# --- STAGE 5: DETECT TRƯỜNG CHỮ (yolo_field_detector.py) ---
# Điền ID model YOLOv8 cắt chữ của bạn vào đây (Ví dụ: vietnamese-id-card-uuil0-02its/1)
FIELD_MODEL_ID=vietnamese-id-card-uuil0-02its/1

# --- CẤU HÌNH THAM SỐ PHỤ (Giữ lại từ file cũ của bạn làm kỷ niệm/dự phòng) ---
VERSION=1
ROBOFLOW_CONFIDENCE=0.35
ROBOFLOW_OVERLAP=0.5
ROBOFLOW_TIMEOUT_SECONDS=30